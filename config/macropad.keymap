#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    behaviors {
        // 노브 스위치: 1초(1000ms) 홀드 -> 레이어 순환 / 짧게 탭 -> 일반 키 입력
        ht_to: hold_tap_to {
            compatible = "zmk,behavior-hold-tap";
            label = "HT_TO";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <1000>;
            bindings = <&to>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ==========================================
        // [레이어 0] Layer 1 (LED 1 점등)
        // ==========================================
        layer_0 {
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
            bindings = <
                &kp F13    &kp F14    &kp F15
                &kp F16    &kp F17    &kp F18
                &tog 4     &ht_to 1 C_PP
            >;
        };

        // ==========================================
        // [레이어 1] Layer 2 (LED 2 점등)
        // ==========================================
        layer_1 {
            sensor-bindings = <&inc_dec_kp N2 N3>;
            bindings = <
                &kp F13    &kp F14    &kp F15
                &kp F16    &kp F17    &kp F18
                &tog 4     &ht_to 2 N1
            >;
        };

        // ==========================================
        // [레이어 2] Layer 3 (LED 3 점등)
        // ==========================================
        layer_2 {
            sensor-bindings = <&inc_dec_kp N2 N3>;
            bindings = <
                &kp F13    &kp F14    &kp F15
                &kp F16    &kp F17    &kp F18
                &tog 4     &ht_to 3 N1
            >;
        };

        // ==========================================
        // [레이어 3] Layer 4 (LED 4 점등)
        // ==========================================
        layer_3 {
            sensor-bindings = <&inc_dec_kp N2 N3>;
            bindings = <
                &kp F13    &kp F14    &kp F15
                &kp F16    &kp F17    &kp F18
                &tog 4     &ht_to 0 N1
            >;
        };

        // ==========================================
        // [레이어 4] 키 잠금 / 전원 Off 모드 (모든 LED 소등)
        // ==========================================
        lock_layer {
            sensor-bindings = <&inc_dec_kp 0 0>;
            bindings = <
                &none      &none      &none
                &none      &none      &none
                &tog 4     &none
            >;
        };
    };
};
